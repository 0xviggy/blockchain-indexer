# Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================================================
# RPC ENDPOINTS
# ============================================================================
# Get free API keys from: https://www.alchemy.com/ or https://infura.io/

# Ethereum Mainnet
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ETH_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Polygon
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
POLYGON_WS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Arbitrum
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ARBITRUM_WS_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Optimism
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
OPTIMISM_WS_URL=wss://opt-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Base
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_WS_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgres://indexer:password@localhost:5432/indexer?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=indexer
DB_PASSWORD=password
DB_NAME=indexer

# ============================================================================
# REDIS
# ============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================================================
# KAFKA
# ============================================================================
KAFKA_BROKERS=localhost:19092
KAFKA_TOPICS_RAW_BLOCKS=raw.blocks
KAFKA_TOPICS_PARSED_EVENTS=parsed.events
KAFKA_TOPICS_SYSTEM_REORG=system.reorg

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================
SERVICE_NAME=indexer
LOG_LEVEL=info
ENVIRONMENT=development

# Ingester Configuration
INGESTER_START_BLOCK=18000000
INGESTER_BATCH_SIZE=100
INGESTER_CHECKPOINT_INTERVAL=10s

# Processor Configuration
PROCESSOR_BATCH_SIZE=1000
PROCESSOR_CONCURRENCY=10

# API Configuration
API_PORT=8000
API_RATE_LIMIT=100
API_CACHE_TTL=300s
